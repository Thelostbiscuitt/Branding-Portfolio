{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "HABIBCORE design tokens v1.0 — W3C Design Tokens (DTCG) format. Source of truth: HABIBCORE_Identity_System.pdf, Edition 2026. Mirror of tokens.css. PDF palette is canonical (see tokens.css header note).",
  "$extensions": {
    "org.habibcore.meta": {
      "version": "1.0.0",
      "edition": "2026",
      "paletteNote": "Brief-listed warm palette (#111111/#F5F3EE) superseded by PDF decision record (Part 06).",
      "angleSystem": "Only 42deg (fold) and 147deg (counter-fold) diagonals exist in this system.",
      "signalBudget": "<=1% of any surface; states/annotation/decision-series only."
    }
  },
  "color": {
    "ink":        { "$type": "color", "$value": "#0A0A0A", "$description": "Ground, text, plates, motion assembly" },
    "paper":      { "$type": "color", "$value": "#FFFFFF", "$description": "Documents, interfaces, the default canvas" },
    "grey": {
      "1":        { "$type": "color", "$value": "#F4F4F2", "$description": "G1 — fields, table stripes, quiet panels" },
      "2":        { "$type": "color", "$value": "#E6E6E3", "$description": "G2 — hairlines, dividers, disabled" },
      "3":        { "$type": "color", "$value": "#6E6E6A", "$description": "G3 — metadata, captions, secondary text" }
    },
    "signal":     { "$type": "color", "$value": "#FF4B00", "$description": "SIGNAL — states only: live, error, decision, annotation. Budget <=1%." },
    "opacity": {
      "beat1":    { "$type": "number", "$value": 1, "$description": "Three-beat dash opacity: long" },
      "beat2":    { "$type": "number", "$value": 0.55, "$description": "Three-beat dash opacity: short" },
      "beat3":    { "$type": "number", "$value": 0.3, "$description": "Three-beat dash opacity: medium" }
    }
  },
  "space": {
    "$description": "Capsule rhythm scale (PDF 03.4): 4/8/12/24/48/96 canonical; 16/32/64 are 8px-logic extensions.",
    "4":   { "$type": "dimension", "$value": "4px", "$extensions": { "org.habibcore.meta": { "tier": "canonical" } } },
    "8":   { "$type": "dimension", "$value": "8px", "$extensions": { "org.habibcore.meta": { "tier": "canonical", "role": "baseline unit" } } },
    "12":  { "$type": "dimension", "$value": "12px", "$extensions": { "org.habibcore.meta": { "tier": "canonical" } } },
    "16":  { "$type": "dimension", "$value": "16px", "$extensions": { "org.habibcore.meta": { "tier": "extended" } } },
    "24":  { "$type": "dimension", "$value": "24px", "$extensions": { "org.habibcore.meta": { "tier": "canonical" } } },
    "32":  { "$type": "dimension", "$value": "32px", "$extensions": { "org.habibcore.meta": { "tier": "extended" } } },
    "48":  { "$type": "dimension", "$value": "48px", "$extensions": { "org.habibcore.meta": { "tier": "canonical" } } },
    "64":  { "$type": "dimension", "$value": "64px", "$extensions": { "org.habibcore.meta": { "tier": "extended" } } },
    "96":  { "$type": "dimension", "$value": "96px", "$extensions": { "org.habibcore.meta": { "tier": "canonical" } } }
  },
  "radius": {
    "plane":      { "$type": "dimension", "$value": "2px", "$description": "plane-small: buttons, chips, inputs" },
    "capsule":    { "$type": "dimension", "$value": "6px", "$description": "capsule: dash ends, pill states" },
    "planeLarge": { "$type": "dimension", "$value": "10%", "$description": "plane-large: panels, cards (10% of width)" }
  },
  "angle": {
    "fold":    { "$type": "number", "$value": -42, "$description": "Fold axis. The only diagonal family #1 (planes, dashes, crops)." },
    "counter": { "$type": "number", "$value": 147, "$description": "Counter-fold (= -33 screen-space). The only diagonal family #2 (floor edges, baselines)." }
  },
  "borderWidth": {
    "keyline":  { "$type": "dimension", "$value": "1.5px", "$description": "Plate frames, specimen borders (P-03)" },
    "hairline": { "$type": "dimension", "$value": "1px", "$description": "Structural hairlines (0.5px print-only)" }
  },
  "iconStroke": {
    "grid":     { "$type": "dimension", "$value": "24px", "$description": "Icon grid" },
    "width":    { "$type": "dimension", "$value": "2px", "$description": "Icon stroke, rounded caps/joins" },
    "widthSm":  { "$type": "dimension", "$value": "2.5px", "$description": "Stroke at <=16px (16px rule)" }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Archivo", "Liberation Sans", "sans-serif"],
      "$description": "Sole sans. Variable wdth 62-125 / wght 100-900. One width per block."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["IBM Plex Mono", "Courier New", "monospace"],
      "$description": "Instrument voice: metadata, labels, code, tables, legal."
    }
  },
  "fontWeight": {
    "display":  { "$type": "fontWeight", "$value": 850 },
    "display2": { "$type": "fontWeight", "$value": 820 },
    "subhead":  { "$type": "fontWeight", "$value": 750 },
    "body":     { "$type": "fontWeight", "$value": 400 },
    "bodyMed":  { "$type": "fontWeight", "$value": 500 },
    "cond":     { "$type": "fontWeight", "$value": 500 }
  },
  "fontWidth": {
    "display":  { "$type": "number", "$value": 120, "$description": "Wordmark + display caps (wdth axis)" },
    "display2": { "$type": "number", "$value": 114 },
    "subhead":  { "$type": "number", "$value": 106 },
    "text":     { "$type": "number", "$value": 100 },
    "cond":     { "$type": "number", "$value": 76, "$description": "Dense data tables only" }
  },
  "typography": {
    "displayXl": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.sans}", "fontWeight": 850, "fontSize": "clamp(44px, 6.5vw, 80px)", "fontStretch": "120%", "letterSpacing": "-0.01em", "lineHeight": "0.96", "textTransform": "uppercase" }
    },
    "display": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.sans}", "fontWeight": 820, "fontSize": "clamp(24px, 3vw, 36px)", "fontStretch": "114%", "letterSpacing": "-0.01em", "lineHeight": "1", "textTransform": "uppercase" }
    },
    "subhead": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.sans}", "fontWeight": 750, "fontSize": "clamp(16px, 1.7vw, 19px)", "fontStretch": "106%", "lineHeight": "1.2", "textTransform": "uppercase" }
    },
    "body": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.sans}", "fontWeight": 400, "fontSize": "clamp(14px, 1.1vw, 16px)", "lineHeight": "1.6" }
    },
    "meta": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.mono}", "fontWeight": 500, "fontSize": "10px", "letterSpacing": "0.15em", "textTransform": "uppercase" }
    },
    "data": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.mono}", "fontWeight": 400, "fontSize": "12px", "lineHeight": "1.5", "fontVariantNumeric": "tabular-nums" }
    },
    "legal": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.mono}", "fontWeight": 400, "fontSize": "9px", "lineHeight": "1.6" }
    },
    "button": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.mono}", "fontWeight": 500, "fontSize": "10px", "letterSpacing": "0.12em", "textTransform": "uppercase" }
    },
    "nav": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.mono}", "fontWeight": 500, "fontSize": "11px", "letterSpacing": "0.14em", "textTransform": "uppercase" }
    },
    "projectIndex": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.mono}", "fontWeight": 500, "fontSize": "9px", "letterSpacing": "0.14em", "textTransform": "uppercase", "$description": "Card metadata line: 014 / AI / PRODUCT - 2025" }
    }
  },
  "grid": {
    "columns":    { "$type": "number", "$value": 12 },
    "gutter":     { "$type": "dimension", "$value": "16px", "$description": "Web gutter; 4mm print" },
    "gutterWide": { "$type": "dimension", "$value": "24px", "$description": "Gutter at >=1024px" },
    "baseline":   { "$type": "dimension", "$value": "8px" },
    "railInset":  { "$type": "dimension", "$value": "40px", "$description": "Metadata rail = rightmost column minus 40px" },
    "pageMargin": { "$type": "dimension", "$value": "clamp(16px, 6vmin, 96px)", "$description": "6% of short edge, clamped to rhythm" }
  },
  "container": {
    "maxWidth":     { "$type": "dimension", "$value": "1440px" },
    "readingMeasure": { "$type": "dimension", "$value": "68ch" }
  },
  "breakpoint": {
    "mobile":  { "$type": "dimension", "$value": "640px", "$extensions": { "org.habibcore.meta": { "tier": "extended" } } },
    "desktop": { "$type": "dimension", "$value": "1024px", "$extensions": { "org.habibcore.meta": { "tier": "extended" } } },
    "wide":    { "$type": "dimension", "$value": "1440px", "$extensions": { "org.habibcore.meta": { "tier": "extended" } } }
  },
  "touch": {
    "minTarget": { "$type": "dimension", "$value": "44px", "$description": "Minimum touch target (PDF 10.4)" }
  },
  "dash": {
    "height":  { "$type": "dimension", "$value": "5px", "$description": "5-6px @1440" },
    "long":    { "$type": "dimension", "$value": "22px" },
    "short":   { "$type": "dimension", "$value": "12px" },
    "medium":  { "$type": "dimension", "$value": "17px" }
  },
  "duration": {
    "micro":    { "$type": "duration", "$value": "120ms", "$description": "T_MICRO — hover lifts, focus rings, chips" },
    "ui":       { "$type": "duration", "$value": "240ms", "$description": "T_UI — menus, tabs, accordions, card fold" },
    "lock":     { "$type": "duration", "$value": "320ms", "$description": "T_LOCK — the signature settle" },
    "assemble": { "$type": "duration", "$value": "1350ms", "$description": "T_ASSEMBLE — logo build; once per session" },
    "page":     { "$type": "duration", "$value": "420ms", "$description": "T_PAGE — plate slide, one column" },
    "textfold": { "$type": "duration", "$value": "360ms", "$description": "T_TEXTFOLD — width 76->120, display only" }
  },
  "easing": {
    "out":    { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1], "$description": "T_MICRO ease-out" },
    "ui":     { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1], "$description": "T_UI — documented in PDF 09.5" },
    "lock":   { "$type": "cubicBezier", "$value": [0.3, 1.18, 0.38, 1], "$description": "T_LOCK <=2% overshoot + settle (approximation)" },
    "travel": { "$type": "cubicBezier", "$value": [0, 0, 1, 1], "$description": "T_SPLINE: linear travel on -42deg paths only" }
  },
  "motion": {
    "$description": "Reduced-motion contract (PDF 09.6): assembly->single fade at T_LOCK; dash loaders->static 42% fill; reveals->settled; live dot->steady.",
    "hoverLift":  { "$type": "dimension", "$value": "-2px", "$description": "Plate lift on hover (FIG. 13)" }
  },
  "brandArchitecture": {
    "$description": "Master brand HABIBCORE(R); 8 disciplines as plain-text metadata; products (Biscuit AI, Relay) as endorsed guests: own name + 'a HABIBCORE system' endorsement; no product logos."
  },
  "caseStudyPlates": {
    "$description": "Fixed five-plate anatomy: 01 BRIEF / 02 SYSTEM / 03 BUILD / 04 PROOF / 05 OPERATE (Signal-indexed)."
  }
}
